# Supabase — get these from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API — enable at https://console.cloud.google.com → APIs → Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Gemini API (FREE) — get key at https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Your deployed URL (set this in Vercel dashboard as well)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
